# Razorpay Test Mode Credentials
# Get these from Razorpay Dashboard -> Settings -> API Keys (in Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Provider Configuration (supports Gemini, Claude/Anthropic, or Groq)
# Default is Google Gemini (free tier supported)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Active LLM Provider: 'gemini', 'anthropic', 'groq', or 'mock' (for offline testing)
LLM_PROVIDER=gemini

# Application Settings
WEBHOOK_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
